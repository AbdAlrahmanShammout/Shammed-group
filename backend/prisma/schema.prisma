generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id                     Int           @id @default(autoincrement())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  originalFileName       String
  storedFileName         String
  mimeType               String
  byteSize               Int
  storageKey             String        @unique
  siteSettingsLogo        SiteSettings? @relation("SiteSettingsLogo")
  siteSettingsFavicon     SiteSettings? @relation("SiteSettingsFavicon")
  siteSettingsPlaceholder SiteSettings? @relation("SiteSettingsPlaceholder")
  partnerLogo            Partner?      @relation("PartnerLogo")
  productImage           Product?      @relation("ProductImage")
  serviceImage           Service?      @relation("ServiceImage")
  homePageHeroImage      HomePage?     @relation("HomePageHeroImage")
  homePageAboutImage     HomePage?     @relation("HomePageAboutPreviewImage")
  homePageWhyImage       HomePage?     @relation("HomePageWhyImage")
  aboutPageOverviewImage AboutPage?    @relation("AboutPageOverviewImage")
}

model SiteSettings {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  companyName        String
  companyNameEnglish String
  companyNameArabic  String?
  email              String
  phone              String
  whatsApp           String?
  address            String?
  logoMediaId           Int?     @unique
  faviconMediaId        Int?     @unique
  placeholderMediaId    Int?     @unique
  primaryColor          String?
  accentColor           String?
  backgroundColor       String?
  textColor             String?
  secondaryColor        String?
  borderColor           String?
  logo                  Media?   @relation("SiteSettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  favicon               Media?   @relation("SiteSettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  placeholder           Media?   @relation("SiteSettingsPlaceholder", fields: [placeholderMediaId], references: [id], onDelete: SetNull)
}

model Location {
  id            Int             @id @default(autoincrement())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  name          String
  address       String
  googleMapsUrl String?
  latitude      Decimal?        @db.Decimal(10, 7)
  longitude     Decimal?        @db.Decimal(10, 7)
  isVisible     Boolean         @default(true)
  isMapVisible  Boolean         @default(true)
  displayOrder  Int             @default(0)
  phones        LocationPhone[]
}

model LocationPhone {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  phone        String
  displayOrder Int      @default(0)
  locationId   Int
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  platform     String
  url          String
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
}

model Partner {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  name             String
  shortDescription String
  fullDescription  String?
  specialization   String?
  websiteUrl       String?
  country          String?
  isVisible        Boolean   @default(true)
  displayOrder     Int       @default(0)
  logoMediaId      Int?      @unique
  logo             Media?    @relation("PartnerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  products         Product[]
}

model ProductCategory {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  name         String
  description  String?
  isVisible    Boolean   @default(true)
  displayOrder Int       @default(0)
  products     Product[]
}

model Product {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  name                String
  shortDescription    String
  detailedDescription String?
  manufacturer        String?
  isVisible           Boolean         @default(true)
  displayOrder        Int             @default(0)
  categoryId          Int
  partnerId           Int?
  imageMediaId        Int?            @unique
  category            ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partner             Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  image               Media?          @relation("ProductImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
}

model Service {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  title        String
  description  String
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  imageMediaId Int?     @unique
  image        Media?   @relation("ServiceImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
}

model HomePage {
  id                         Int      @id @default(autoincrement())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  singletonKey               String   @unique @default("default")
  heroTitle                  String
  heroDescription            String
  heroImageMediaId           Int?     @unique
  primaryCtaText             String
  primaryCtaUrl              String
  secondaryCtaText           String
  secondaryCtaUrl            String
  aboutPreviewTitle          String
  aboutPreviewDescription    String
  aboutPreviewImageMediaId   Int?     @unique
  aboutPreviewCtaText        String
  aboutPreviewCtaUrl         String
  partnersSectionTitle       String
  partnersSectionDescription String?
  productsSectionTitle       String
  productsSectionDescription String?
  servicesSectionTitle       String
  servicesSectionDescription String?
  whyTitle                   String
  whyDescription             String
  whyImageMediaId            Int?     @unique
  contactSectionTitle        String
  contactSectionDescription  String?
  heroImage                  Media?   @relation("HomePageHeroImage", fields: [heroImageMediaId], references: [id], onDelete: SetNull)
  aboutPreviewImage          Media?   @relation("HomePageAboutPreviewImage", fields: [aboutPreviewImageMediaId], references: [id], onDelete: SetNull)
  whyImage                   Media?   @relation("HomePageWhyImage", fields: [whyImageMediaId], references: [id], onDelete: SetNull)
}

model AboutPage {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  singletonKey         String   @unique @default("default")
  overview             String
  overviewImageMediaId Int?     @unique
  vision               String
  mission              String
  values               String
  capabilities         String
  overviewImage        Media?   @relation("AboutPageOverviewImage", fields: [overviewImageMediaId], references: [id], onDelete: SetNull)
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model ContactInquiry {
  id                  Int                 @id @default(autoincrement())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  fullName            String
  email               String
  phone               String?
  subject             String
  message             String
  emailDeliveryStatus EmailDeliveryStatus @default(PENDING)
  emailDeliveredAt    DateTime?
}
